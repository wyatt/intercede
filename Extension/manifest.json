{
  "manifest_version": 3,
  "name": "FocusPet",
  "description": "Lets your FocusPet companion dissolve the distracting page when it shows up.",
  "version": "0.1.0",
  "key": "",
  "minimum_chrome_version": "110",
  "permissions": ["nativeMessaging", "scripting", "tabs", "alarms"],
  "host_permissions": ["<all_urls>"],
  "background": { "service_worker": "src/background.js" },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
